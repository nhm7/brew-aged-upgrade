#!/usr/bin/env bash
set -euo pipefail

MIN_DAYS="${BREW_AGE_MIN_DAYS:-3}"
STATE_DIR="${HOME}/.config/brew-aged-upgrade"
STATE_FILE="${STATE_DIR}/pending.json"
LOG_FILE="${HOME}/Library/Logs/brew-aged-upgrade.log"
PLIST_LABEL="com.nhm7.brew-aged-upgrade"
PLIST_PATH="${HOME}/Library/LaunchAgents/${PLIST_LABEL}.plist"
LIBEXEC="$(cd "$(dirname "$0")" && pwd)"
CORE="${LIBEXEC}/brew-aged-upgrade-core.py"

_die() { echo "Error: $*" >&2; exit 1; }

log_file() {
  mkdir -p "$(dirname "$LOG_FILE")"
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >> "$LOG_FILE"
}

log_stdout() {
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*"
  if [[ -t 1 ]]; then
    log_file "$*"
  fi
}

prune_logs() {
  [[ -f "$LOG_FILE" ]] && python3 "$CORE" --prune-log "$LOG_FILE" || true
}

cmd_start() {
  local days="$MIN_DAYS"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --days) days="${2:?--days requires a value}"; shift 2 ;;
      *) _die "Unknown option: $1" ;;
    esac
  done

  local self
  self="$(command -v brew-aged-upgrade)" || _die "brew-aged-upgrade not found on PATH"

  mkdir -p "${HOME}/Library/LaunchAgents" "$STATE_DIR"

  cat > "$PLIST_PATH" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${PLIST_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${self}</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BREW_AGE_MIN_DAYS</key><string>${days}</string>
    <key>HOME</key><string>${HOME}</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key><integer>86400</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>${LOG_FILE}</string>
  <key>StandardErrorPath</key><string>${LOG_FILE}</string>
</dict>
</plist>
PLIST

  if brew autoupdate status 2>/dev/null | grep -qi "autoupdate is installed"; then
    echo "Warning: brew autoupdate is also installed and conflicts with brew-aged-upgrade"
    echo "         (both run brew update/upgrade daily)."
    printf "Remove brew autoupdate now? [y/N] "
    read -r answer
    case "$answer" in
      y|Y|yes|Yes|YES)
        brew autoupdate delete
        ;;
      *)
        echo "Aborted. Run 'brew autoupdate delete' first, then re-run 'brew-aged-upgrade start'."
        exit 1
        ;;
    esac
  fi

  launchctl load -w "$PLIST_PATH" 2>/dev/null \
    || launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH"

  echo "==> brew-aged-upgrade started (min age: ${days} day(s), runs every 24h)"
  echo "    Log: ${LOG_FILE}"
}

cmd_stop() {
  if [[ ! -f "$PLIST_PATH" ]]; then
    echo "brew-aged-upgrade is not running"
    return
  fi
  launchctl unload -w "$PLIST_PATH" 2>/dev/null \
    || launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null \
    || true
  rm -f "$PLIST_PATH"
  echo "==> brew-aged-upgrade stopped"
  echo "    Watch timers preserved at ${STATE_FILE}"
  echo "    Delete that file to reset all timers, or just run 'start' to resume."
}

cmd_status() {
  if [[ -f "$PLIST_PATH" ]]; then
    local days
    days=$(python3 -c "
import plistlib, sys
with open(sys.argv[1], 'rb') as f:
    p = plistlib.load(f)
print(p.get('EnvironmentVariables', {}).get('BREW_AGE_MIN_DAYS', '3'))
" "$PLIST_PATH" 2>/dev/null || echo "3")
    echo "==> brew-aged-upgrade is installed and running"
    echo "    Min age : ${days} day(s)"
    echo "    Plist   : ${PLIST_PATH}"
    echo "    Log     : ${LOG_FILE}"
  else
    echo "==> brew-aged-upgrade is not running"
    echo "    Run 'brew-aged-upgrade start' to enable"
  fi

  if [[ -f "$STATE_FILE" ]]; then
    echo ""
    echo "Pending packages (watching, not yet upgraded):"
    python3 "$CORE" --status "$STATE_FILE"
  fi
}

cmd_run() {
  mkdir -p "$STATE_DIR" "$(dirname "$LOG_FILE")"
  prune_logs
  [[ -t 1 ]] && export BREW_AGE_LOG_FILE="$LOG_FILE"
  [[ -f "$STATE_FILE" ]] || echo '{}' > "$STATE_FILE"
  log_stdout "==> brew-aged-upgrade run at $(date) (min age: ${MIN_DAYS}d)"
  log_file "==> Running brew update --quiet"
  brew update --quiet
  log_file "==> Running brew outdated --json=v2"
  brew outdated --json=v2 \
    | BREW_AGE_STATE_FILE="$STATE_FILE" BREW_AGE_MIN_DAYS="$MIN_DAYS" python3 "$CORE" --run
  log_stdout "==> done"
}

usage() {
  cat <<EOF
Usage: brew-aged-upgrade <command> [options]

Commands:
  start [--days N]   Enable daily auto-upgrade with N-day delay (default: ${MIN_DAYS})
  stop               Disable auto-upgrade and remove the launchd job
  status             Show status and packages currently being watched
  run                Run once immediately
  help               Show this help

Environment:
  BREW_AGE_MIN_DAYS  Override the minimum age in days (default: 3)
EOF
}

case "${1:-help}" in
  start)  shift; cmd_start "$@" ;;
  stop)   cmd_stop ;;
  status) cmd_status ;;
  run)    cmd_run ;;
  help|--help|-h) usage ;;
  *) echo "Unknown command: $1" >&2; usage >&2; exit 1 ;;
esac
